<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="roarm_ros2_control" params="use_gazebo GZ_VERSION gripper_type initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="RoarmHardware" type="system">

            <hardware>
              <xacro:unless value="${use_gazebo}">
              <plugin>mock_components/GenericSystem</plugin>
              </xacro:unless>
              <xacro:if value="${use_gazebo}">
                <xacro:if value="${GZ_VERSION == 'classic'}">
                  <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                </xacro:if>    
                <xacro:if value="${GZ_VERSION == 'harmonic'}">
                  <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>         
              </xacro:if>    
            </hardware>
            
            <joint name="base_link_to_link1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_link_to_link1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link1_to_link2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['link1_to_link2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link2_to_link3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['link2_to_link3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['gripper_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <!-- Same as standalone roarm_m2: Harmonic drives finger mimics via gz_ros2_control
                 (URDF <mimic> alone is not enough for dartsim). -->
            <xacro:if value="${gripper_type == 'angular_gear'}">
            <joint name="gripper_left_joint1">
              <param name="mimic">gripper_joint</param>
              <param name="multiplier">1</param>
              <state_interface name="position">
                <param name="initial_value">${initial_positions['gripper_joint']}</param>
              </state_interface>
              <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_left_joint2">
              <param name="mimic">gripper_joint</param>
              <param name="multiplier">1</param>
              <state_interface name="position">
                <param name="initial_value">${initial_positions['gripper_joint']}</param>
              </state_interface>
              <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_left_joint3">
              <param name="mimic">gripper_joint</param>
              <param name="multiplier">-1</param>
              <state_interface name="position">
                <param name="initial_value">${initial_positions['gripper_joint']}</param>
              </state_interface>
              <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_right_joint1">
              <param name="mimic">gripper_joint</param>
              <param name="multiplier">1</param>
              <state_interface name="position">
                <param name="initial_value">${initial_positions['gripper_joint']}</param>
              </state_interface>
              <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_right_joint2">
              <param name="mimic">gripper_joint</param>
              <param name="multiplier">-1</param>
              <state_interface name="position">
                <param name="initial_value">${initial_positions['gripper_joint']}</param>
              </state_interface>
              <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_right_joint3">
              <param name="mimic">gripper_joint</param>
              <param name="multiplier">1</param>
              <state_interface name="position">
                <param name="initial_value">${initial_positions['gripper_joint']}</param>
              </state_interface>
              <state_interface name="velocity"/>
            </joint>
            </xacro:if>
            <joint name="left_down_wheel_link_joint">
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            <joint name="left_up_wheel_link_joint">
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            <joint name="right_down_wheel_link_joint">
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
            </joint>       
            <joint name="right_up_wheel_link_joint">
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
            </joint> 
        </ros2_control>
    </xacro:macro>
</robot>
