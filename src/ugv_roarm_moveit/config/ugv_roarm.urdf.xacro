<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ugv_roarm">

<!-- Single entry-point declarations for the whole ugv_roarm tree. -->
<xacro:macro name="use_gazebo" params="use_gazebo"></xacro:macro>
<xacro:arg name="use_gazebo" default="false"/>
<xacro:property name="use_gazebo" value="$(arg use_gazebo)"/>

<xacro:macro name="GZ_VERSION" params="GZ_VERSION"></xacro:macro>
<xacro:arg name="GZ_VERSION" default="classic"/>
<xacro:property name="GZ_VERSION" value="$(arg GZ_VERSION)"/>

<xacro:arg name="ugv_model" default="ugv_rover"/>
<xacro:property name="ugv_model" value="$(arg ugv_model)"/>

<xacro:arg name="roarm_model" default="roarm_m2"/>
<xacro:property name="roarm_model" value="$(arg roarm_model)"/>

<xacro:arg name="gripper_type" default="angular_direct"/>
<xacro:property name="gripper_type" value="$(arg gripper_type)"/>

<xacro:macro name="add_camera" params="add_camera"></xacro:macro>
<xacro:arg name="add_camera" default="false"/>
<xacro:property name="add_camera" value="$(arg add_camera)"/>

<xacro:macro name="add_depth_camera" params="add_depth_camera"></xacro:macro>
<xacro:arg name="add_depth_camera" default="false"/>
<xacro:property name="add_depth_camera" value="$(arg add_depth_camera)"/>

<xacro:arg name="add_pt" default="false"/>
<xacro:property name="add_pt" value="$(arg add_pt)"/>

<xacro:arg name="initial_positions_file" default="$(arg roarm_model)/initial_positions.yaml" />
<xacro:include filename="$(arg roarm_model)/$(arg roarm_model).ros2_control.xacro" />

<xacro:roarm_ros2_control use_gazebo="$(arg use_gazebo)" GZ_VERSION="$(arg GZ_VERSION)" gripper_type="$(arg gripper_type)" initial_positions_file="$(arg initial_positions_file)"/>

<xacro:include filename="$(find ugv_roarm_description)/urdf/ugv_roarm.xacro"/>

<gazebo>
    <xacro:if value="${GZ_VERSION == 'classic'}">
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find ugv_roarm_moveit)/config/$(arg roarm_model)/ros2_controllers.yaml</parameters>
    </plugin>
    </xacro:if>
    <xacro:if value="${GZ_VERSION == 'harmonic'}">
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
        <parameters>$(find ugv_roarm_moveit)/config/$(arg roarm_model)/ros2_controllers.yaml</parameters>
    </plugin>
    </xacro:if>
</gazebo>

</robot>
